#!/usr/bin/env zsh
# ─────────────────────────────────────────────────────────────
# glab-helper — Interactive GitLab workflow helper
# ─────────────────────────────────────────────────────────────
#
# SETUP:
#   1. Install dependencies:
#        brew install glab fzf jq
#
#   2. Authenticate glab:
#        glab auth login
#      → Choose your GitLab instance URL
#      → Auth method: Token
#      → Create token at: Settings → Access Tokens
#        (Scopes: api, read_repository, write_repository)
#      → Protocol: HTTPS (or SSH if configured)
#
#   3. Verify:
#        glab auth status
#
#   4. Run from any GitLab repo:
#        glab-helper
#
# DEPENDENCIES: glab, fzf (0.35+), jq, curl, nvim (optional, falls back to vim)
# ─────────────────────────────────────────────────────────────

# Reset zsh options so user shell tracing/debug flags do not leak into the TUI.
emulate -R zsh
unsetopt xtrace verbose
setopt typesetsilent
SCRIPT_DIR="${0:P:h}"

# ─── Help flag ───
DEV_MODE=false
if [[ "$1" == "--dev" || "$1" == "-d" ]]; then
  DEV_MODE=true
  shift
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo ""
  echo "  glab-helper — Interactive GitLab workflow helper"
  echo ""
  echo "  Usage: glab-helper [--dev]"
  echo ""
  echo "  Options:"
  echo "    --dev, -d   Enable developer mode (advanced commands, skip Jira project check)"
  echo ""
  echo "  Run from any cloned GitLab repo. Requires: glab, fzf, jq"
  echo "  Authenticate first: glab auth login"
  echo ""
  exit 0
fi

# ─── Colors & Symbols ───
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'
CYAN=$'\033[36m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
MAGENTA=$'\033[35m'

ICON_OK="✔"
ICON_WARN="!"
ICON_TITLE="▸"
ICON_LABEL="◆"
ICON_USER="◉"
ICON_MILE="▷"
ICON_DESC="¶"
ICON_NEW="+"
ICON_BRANCH="⎇"
ICON_SYNC="~"

BOX="${CYAN}${BOLD}"
BOX_V="${BOX}│${RESET}"

for lib_file in common transforms gitlab_api jira_api ui_helpers; do
  source "$SCRIPT_DIR/lib/${lib_file}.zsh" || exit 1
done
for flow_file in sync_epics sync_stories work_issue create_issue; do
  source "$SCRIPT_DIR/flows/${flow_file}.zsh" || exit 1
done

# ─── Dependency check ───
missing=()
for cmd in glab fzf jq curl; do
  if ! command -v "$cmd" &>/dev/null; then
    missing+=("$cmd")
  fi
done
if [[ ${#missing[@]} -gt 0 ]]; then
  echo ""
  echo "  ${RED}${ICON_WARN} Missing dependencies:${RESET} ${missing[*]}"
  echo ""
  echo "  Install with:"
  if [[ "$(uname)" == "Darwin" ]]; then
    echo "    ${DIM}brew install ${missing[*]}${RESET}"
  else
    echo "    ${DIM}sudo pacman -S ${missing[*]}${RESET}"
  fi
  echo ""
  echo "  Then authenticate glab:"
  echo "    ${DIM}glab auth login${RESET}"
  echo ""
  exit 1
fi

# ─── Temp file cleanup ───
_tmpfiles=()
cleanup_tmpfiles() { for f in "${_tmpfiles[@]}"; do rm -f "$f" 2>/dev/null; done; }
trap 'cleanup_tmpfiles' EXIT INT TERM

# ─── Clear screen ───
clear

# ─── Repo info ───
echo ""
echo -n "  ${DIM}Connecting to GitLab...${RESET}"

repo_info=$(glab repo view --output json 2>/dev/null) || {
  printf "\r                                \r"
  echo ""
  echo "  ${RED}${ICON_WARN} Not in a GitLab repo or not authenticated.${RESET}"
  echo ""
  echo "  Make sure you:"
  echo "    1. ${DIM}cd${RESET} into a cloned GitLab repo"
  echo "    2. Run ${DIM}glab auth login${RESET} if not yet authenticated"
  echo "    3. Run ${DIM}glab auth status${RESET} to verify"
  echo ""
  exit 1
}

repo_name=$(jq -r '.path_with_namespace // .name_with_namespace // .name // "unknown"' <<< "$repo_info")
project_id=$(jq -r '.id' <<< "$repo_info")

printf "\r                                \r"

# ─── Dynamic header box width ───
if [[ ${#repo_name} -gt 80 ]]; then
  repo_name="${repo_name:0:77}..."
fi
BOX_WIDTH=$(( ${#repo_name} > 40 ? ${#repo_name} + 8 : 48 ))

box_line() {
  local text="$1"
  local visible_len=${#text}
  local pad=$((BOX_WIDTH - visible_len - 2))
  if [[ $pad -lt 0 ]]; then pad=0; fi
  local spaces=""
  if [[ $pad -gt 0 ]]; then
    spaces=$(printf '%*s' "$pad" '')
  fi
  echo "  ${BOX}║${RESET}  ${text}${spaces}${BOX}║${RESET}"
}

# ─── Header ───
box_top="$(printf '═%.0s' $(seq 1 $BOX_WIDTH))"

echo ""
echo "  ${BOX}╔${box_top}╗${RESET}"
box_line "GitLab Helper"
box_line "${repo_name}"
echo "  ${BOX}╚${box_top}╝${RESET}"
echo ""

# ─── Shared helpers & API modules ───
echo -n "  ${DIM}Checking Jira integration...${RESET}"
if load_jira_config; then
  JIRA_AVAILABLE=true
  printf "\r                                      \r"
  echo "  ${GREEN}${ICON_OK}${RESET} ${DIM}Jira integration available${RESET}"
else
  printf "\r                                      \r"
fi
echo ""

# ═══════════════════════════════════════════
# MAIN MENU
# ═══════════════════════════════════════════

menu_options="${ICON_NEW} Create issue
${ICON_TITLE} Work on existing issue"
if $JIRA_AVAILABLE; then
  menu_options="${menu_options}
${ICON_SYNC} Sync epics from Jira
${ICON_SYNC} Sync stories from Jira"
fi
if $DEV_MODE; then
  menu_options="${menu_options}
${ICON_WARN} Reset: delete all issues & milestones"
fi

action=$(fzf \
  --prompt="  What do you want to do? > " \
  --header="  ENTER=select" \
  --height=~40 \
  --reverse \
  --border=rounded \
  --border-label=" action " \
  --color="border:cyan,header:dim,prompt:cyan" \
  <<< "$menu_options" \
  || echo "")

if [[ -z "$action" ]]; then
  echo "  ${YELLOW}${ICON_WARN}${RESET} Aborted."
  exit 0

# ═══════════════════════════════════════════════════════════════
# PATH: WORK ON EXISTING ISSUE
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Work on existing"* ]]; then
  work_on_existing_issue

# ═══════════════════════════════════════════════════════════════
# PATH: CREATE ISSUE
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Create"* ]]; then
  create_issue

# ═══════════════════════════════════════════════════════════════
# PATH: SYNC EPICS FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Sync epics"* ]]; then
  sync_epics
  exit 0

# ═══════════════════════════════════════════════════════════════
# PATH: SYNC STORIES FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Sync stories"* ]]; then
  sync_stories
  exit 0

# ═══════════════════════════════════════════════════════════════
# PATH: RESET (test mode only)
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Reset"* ]]; then
  echo ""
  echo "  ${RED}${ICON_WARN}${RESET} ${BOLD}Reset: delete all issues & milestones${RESET}"
  echo ""

  # Count issues and milestones (paginated, all states)
  echo -n "  ${DIM}Counting...${RESET}"
  issues_json=$(fetch_all_issues)
  issue_count=$(jq 'length' <<< "$issues_json")
  ms_json=$(fetch_all_milestones "")
  ms_count=$(jq 'length' <<< "$ms_json")

  printf "\r                          \r"

  if [[ "$issue_count" -eq 0 && "$ms_count" -eq 0 ]]; then
    echo "  ${DIM}Nothing to delete.${RESET}"
    echo ""
    exit 0
  fi

  echo "  ${RED}${issue_count}${RESET} issues and ${RED}${ms_count}${RESET} milestones will be deleted."
  echo ""
  echo -n "  ${BOLD}Type '${RED}delete${RESET}${BOLD}' to confirm:${RESET} "
  read -r confirm
  if [[ "$confirm" != "delete" ]]; then
    echo ""
    echo "  ${YELLOW}${ICON_WARN}${RESET} Aborted."
    exit 0
  fi

  echo ""

  # Delete issues
  del_issues=0
  while IFS= read -r iid; do
    [[ -z "$iid" ]] && continue
    if glab api "projects/$project_id/issues/$iid" -X DELETE &>/dev/null; then
      ((del_issues++))
    fi
  done < <(jq -r '.[].iid' <<< "$issues_json")

  # Delete milestones
  del_ms=0
  while IFS= read -r mid; do
    [[ -z "$mid" ]] && continue
    if glab api "projects/$project_id/milestones/$mid" -X DELETE &>/dev/null; then
      ((del_ms++))
    fi
  done < <(jq -r '.[].id' <<< "$ms_json")

  echo "  ${GREEN}${ICON_OK}${RESET} Deleted ${del_issues} issues, ${del_ms} milestones."
  echo ""
  exit 0

fi
