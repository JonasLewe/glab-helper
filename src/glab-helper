# Word-wrap text to a max width
wrap_text() {
  fold -s -w "$2" <<< "$1"
}

# Collect all summary lines (plain text for width calculation)
summary_lines=()
summary_lines+=("Summary")
summary_lines+=("---")  # separator marker
