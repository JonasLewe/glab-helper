summary_lines+=("${ICON_DESC} Description:")

# Wrap description lines at 70 chars and collect them
desc_wrapped=()
while IFS= read -r line; do
  if [[ ${#line} -gt 70 ]]; then
    while IFS= read -r wrapped; do
      desc_wrapped+=("$wrapped")
    done < <(wrap_text "$line" 70)
  else
    desc_wrapped+=("$line")
  fi
done <<< "$description"

for dline in "${desc_wrapped[@]}"; do
  summary_lines+=("   ${dline}")
done

# Find the widest line
max_w=0
for sline in "${summary_lines[@]}"; do
  if [[ "$sline" == "---" ]]; then continue; fi
  local_len=${#sline}
  if [[ $local_len -gt $max_w ]]; then
    max_w=$local_len
  fi
done

# Add padding (2 left + 2 right)
sum_box_w=$((max_w + 4))
if [[ $sum_box_w -lt 30 ]]; then sum_box_w=30; fi

sum_border=$(printf '─%.0s' $(seq 1 $sum_box_w))

# Print summary box
echo ""
echo "  ${BOX}┌${sum_border}┐${RESET}"

for sline in "${summary_lines[@]}"; do
  if [[ "$sline" == "---" ]]; then
    echo "  ${BOX}├${sum_border}┤${RESET}"
    continue
  fi
  local_len=${#sline}
  pad=$((sum_box_w - local_len - 2))
  if [[ $pad -lt 0 ]]; then pad=0; fi
  spaces=""
  if [[ $pad -gt 0 ]]; then
    spaces=$(printf '%*s' "$pad" '')
  fi
  echo "  ${BOX_V} ${sline}${spaces} ${BOX}│${RESET}"
done

echo "  ${BOX}└${sum_border}┘${RESET}"
echo ""

echo -n "  ${BOLD}Create this issue?${RESET} ${DIM}(y/n)${RESET} "
read -r confirm

if [[ "$confirm" != "y" ]]; then
  echo ""
  echo "  ${YELLOW}${ICON_WARN}${RESET} Aborted."
  exit 0
fi

# ─── Build & execute command ───
cmd=(glab issue create -t "$title")

if [[ -n "$labels_csv" ]]; then
  cmd+=(-l "$labels_csv")
fi

if [[ -n "$assignee" ]]; then
  cmd+=(-a "$assignee")
fi

if [[ -n "$milestone" ]]; then
  cmd+=(-m "$milestone")
fi

cmd+=(-d "$description")

echo ""
echo -n "  ${DIM}Creating issue...${RESET}"
output=$("${cmd[@]}" 2>&1)
create_status=$?
printf "\r                       \r"

if [[ $create_status -eq 0 ]]; then
  echo ""
  echo "  ${GREEN}${ICON_OK} Issue created successfully${RESET}"
  echo "  ${DIM}${output}${RESET}"
  echo ""
else
  echo ""
  echo "  ${RED}${ICON_WARN} Failed to create issue${RESET}"
  echo "  ${DIM}${output}${RESET}"
  echo ""
  exit 1
fi

# ═══════════════════════════════════════════
# BRANCH CREATION (after issue create)
# ═══════════════════════════════════════════

# Extract issue number from glab output URL (e.g. .../issues/42)
issue_number=$(grep -oE '/issues/[0-9]+' <<< "$output" | grep -oE '[0-9]+' | tail -1)

if [[ -n "$issue_number" ]]; then
  offer_branch_creation "$issue_number" "$title"
fi

# ═══════════════════════════════════════════════════════════════
# PATH: SYNC EPICS FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Sync epics"* ]]; then
  sync_epics
  exit 0

# ═══════════════════════════════════════════════════════════════
# PATH: SYNC STORIES FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Sync stories"* ]]; then
  sync_stories
  exit 0

# ═══════════════════════════════════════════════════════════════
# PATH: RESET (test mode only)
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Reset"* ]]; then
  echo ""
  echo "  ${RED}${ICON_WARN}${RESET} ${BOLD}Reset: delete all issues & milestones${RESET}"
  echo ""

  # Count issues and milestones (paginated, all states)
  echo -n "  ${DIM}Counting...${RESET}"
  issues_json=$(fetch_all_issues)
  issue_count=$(jq 'length' <<< "$issues_json")
  ms_json=$(fetch_all_milestones "")
  ms_count=$(jq 'length' <<< "$ms_json")

  printf "\r                          \r"

  if [[ "$issue_count" -eq 0 && "$ms_count" -eq 0 ]]; then
    echo "  ${DIM}Nothing to delete.${RESET}"
    echo ""
    exit 0
  fi

  echo "  ${RED}${issue_count}${RESET} issues and ${RED}${ms_count}${RESET} milestones will be deleted."
  echo ""
  echo -n "  ${BOLD}Type '${RED}delete${RESET}${BOLD}' to confirm:${RESET} "
  read -r confirm
  if [[ "$confirm" != "delete" ]]; then
    echo ""
    echo "  ${YELLOW}${ICON_WARN}${RESET} Aborted."
    exit 0
  fi

  echo ""

  # Delete issues
  del_issues=0
  while IFS= read -r iid; do
    [[ -z "$iid" ]] && continue
    if glab api "projects/$project_id/issues/$iid" -X DELETE &>/dev/null; then
      ((del_issues++))
    fi
  done < <(jq -r '.[].iid' <<< "$issues_json")

  # Delete milestones
  del_ms=0
  while IFS= read -r mid; do
    [[ -z "$mid" ]] && continue
    if glab api "projects/$project_id/milestones/$mid" -X DELETE &>/dev/null; then
      ((del_ms++))
    fi
  done < <(jq -r '.[].id' <<< "$ms_json")

  echo "  ${GREEN}${ICON_OK}${RESET} Deleted ${del_issues} issues, ${del_ms} milestones."
  echo ""
  exit 0

fi
