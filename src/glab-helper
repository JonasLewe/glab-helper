#!/usr/bin/env zsh
# ─────────────────────────────────────────────────────────────
# glab-helper — Interactive GitLab workflow helper
# ─────────────────────────────────────────────────────────────
#
# SETUP:
#   1. Install dependencies:
#        brew install glab fzf jq
#
#   2. Authenticate glab:
#        glab auth login
#      → Choose your GitLab instance URL
#      → Auth method: Token
#      → Create token at: Settings → Access Tokens
#        (Scopes: api, read_repository, write_repository)
#      → Protocol: HTTPS (or SSH if configured)
#
#   3. Verify:
#        glab auth status
#
#   4. Run from any GitLab repo:
#        glab-helper
#
# DEPENDENCIES: glab, fzf (0.35+), jq, curl, nvim (optional, falls back to vim)
# ─────────────────────────────────────────────────────────────

# Reset zsh options so user shell tracing/debug flags do not leak into the TUI.
emulate -R zsh
unsetopt xtrace verbose
setopt typesetsilent
SCRIPT_DIR="${0:P:h}"

# ─── CLI flags ───
DEV_MODE=false
DRY_RUN_MODE=false
MAINTENANCE_MODE=false
SCRIPT_FLAGS=()
SHOW_HELP=false
SHOW_VERSION=false
GLAB_HELPER_VERSION="0.1.0"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dev|-d)
      DEV_MODE=true
      shift
      ;;
    --dry-run)
      DRY_RUN_MODE=true
      shift
      ;;
    --maintenance)
      MAINTENANCE_MODE=true
      shift
      ;;
    --help|-h)
      SHOW_HELP=true
      shift
      ;;
    --version)
      SHOW_VERSION=true
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Usage: glab-helper [--dev | --maintenance] [--dry-run] [--version]" >&2
      exit 2
      ;;
  esac
done

if $DEV_MODE && $MAINTENANCE_MODE; then
  echo "--dev and --maintenance cannot be combined." >&2
  exit 2
fi

$DEV_MODE && SCRIPT_FLAGS+=(--dev)
$DRY_RUN_MODE && SCRIPT_FLAGS+=(--dry-run)

if $SHOW_VERSION; then
  echo "glab-helper ${GLAB_HELPER_VERSION}"
  exit 0
fi

if $SHOW_HELP; then
  echo ""
  echo "  glab-helper — Interactive GitLab workflow helper"
  echo ""
  echo "  Usage: glab-helper [--dev | --maintenance] [--dry-run] [--version]"
  echo ""
  echo "  Options:"
  echo "    --dev, -d   Show developer actions and skip the Jira target-project check"
  echo "    --maintenance  Show destructive project maintenance actions"
  echo "    --dry-run   Read-only mode; preview Jira syncs without any writes"
  echo "    --version   Show version and exit"
  echo ""
  echo "  Run from any cloned GitLab repo. Requires: glab, fzf, jq"
  echo "  Authenticate first: glab auth login"
  echo ""
  exit 0
fi

# ─── Colors & Symbols ───
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'
CYAN=$'\033[36m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
MAGENTA=$'\033[35m'

ICON_OK="✔"
ICON_WARN="!"
ICON_TITLE="▸"
ICON_LABEL="◆"
ICON_USER="◉"
ICON_MILE="▷"
ICON_DESC="¶"
ICON_NEW="+"
ICON_BRANCH="⎇"
ICON_SYNC="~"
ICON_EXIT="×"

BOX="${CYAN}${BOLD}"
BOX_V="${BOX}│${RESET}"

for lib_file in common transforms gitlab_api jira_api ui_helpers; do
  source "$SCRIPT_DIR/lib/${lib_file}.zsh" || exit 1
done
for flow_file in sync_epics sync_stories work_issue create_issue reset_jira_sync; do
  source "$SCRIPT_DIR/flows/${flow_file}.zsh" || exit 1
done

# ─── Dependency check ───
missing=()
for cmd in glab fzf jq curl; do
  if ! command -v "$cmd" &>/dev/null; then
    missing+=("$cmd")
  fi
done
if [[ ${#missing[@]} -gt 0 ]]; then
  echo ""
  echo "  ${RED}${ICON_WARN} Missing dependencies:${RESET} ${missing[*]}"
  echo ""
  echo "  Install with:"
  if [[ "$(uname)" == "Darwin" ]]; then
    echo "    ${DIM}brew install ${missing[*]}${RESET}"
  else
    echo "    ${DIM}sudo pacman -S ${missing[*]}${RESET}"
  fi
  echo ""
  echo "  Then authenticate glab:"
  echo "    ${DIM}glab auth login${RESET}"
  echo ""
  exit 1
fi

# ─── Temp file cleanup ───
_tmpfiles=()
cleanup_tmpfiles() { for f in "${_tmpfiles[@]}"; do rm -f "$f" 2>/dev/null; done; }
trap 'cleanup_tmpfiles' EXIT INT TERM

# ─── Clear screen ───
clear

# ─── Repo info ───
echo ""
echo -n "  ${DIM}Connecting to GitLab...${RESET}"

repo_info=$(retry_read_json \
  "GitLab repository" \
  'type == "object" and (.id | type == "number") and ((.path_with_namespace // .name_with_namespace // .name) | type == "string")' \
  glab repo view --output json) || {
  printf "\r                                \r"
  echo ""
  echo "  ${RED}${ICON_WARN} Not in a GitLab repo or not authenticated.${RESET}"
  echo ""
  echo "  Make sure you:"
  echo "    1. ${DIM}cd${RESET} into a cloned GitLab repo"
  echo "    2. Run ${DIM}glab auth login${RESET} if not yet authenticated"
  echo "    3. Run ${DIM}glab auth status${RESET} to verify"
  echo ""
  exit 1
}

repo_name=$(jq -r '.path_with_namespace // .name_with_namespace // .name // "unknown"' <<< "$repo_info")
project_id=$(jq -r '.id' <<< "$repo_info")

printf "\r                                \r"

# ─── Dynamic header box width ───
if [[ ${#repo_name} -gt 80 ]]; then
  repo_name="${repo_name:0:77}..."
fi
BOX_WIDTH=$(( ${#repo_name} > 40 ? ${#repo_name} + 8 : 48 ))

box_line() {
  local text="$1"
  local visible_len=${#text}
  local pad=$((BOX_WIDTH - visible_len - 2))
  if [[ $pad -lt 0 ]]; then pad=0; fi
  local spaces=""
  if [[ $pad -gt 0 ]]; then
    spaces=$(printf '%*s' "$pad" '')
  fi
  echo "  ${BOX}║${RESET}  ${text}${spaces}${BOX}║${RESET}"
}

# ─── Header ───
box_top="$(printf '═%.0s' $(seq 1 $BOX_WIDTH))"

echo ""
echo "  ${BOX}╔${box_top}╗${RESET}"
box_line "GitLab Helper"
box_line "${repo_name}"
echo "  ${BOX}╚${box_top}╝${RESET}"
echo ""

# ─── Shared helpers & API modules ───
echo -n "  ${DIM}Checking Jira integration...${RESET}"
if load_jira_config; then
  JIRA_AVAILABLE=true
  printf "\r                                      \r"
  echo "  ${GREEN}${ICON_OK}${RESET} ${DIM}Jira integration available${RESET}"
else
  printf "\r                                      \r"
fi
echo ""

if $MAINTENANCE_MODE && ! $JIRA_AVAILABLE; then
  echo "  ${RED}${ICON_WARN}${RESET} Maintenance mode requires the configured Jira target project."
  echo ""
  exit 1
fi

# ═══════════════════════════════════════════
# MAIN MENU
# ═══════════════════════════════════════════

if $MAINTENANCE_MODE; then
  if $DRY_RUN_MODE; then
    menu_options="${ICON_WARN} Preview full project reset
${ICON_EXIT} Exit"
  else
    menu_options="${ICON_WARN} Reset all issues & milestones
${ICON_EXIT} Exit"
  fi
elif $DRY_RUN_MODE; then
  if ! $JIRA_AVAILABLE; then
    echo "  ${YELLOW}${ICON_WARN}${RESET} No read-only Jira previews are available."
    echo ""
    exit 0
  fi
  if $DEV_MODE; then
    menu_options="${ICON_SYNC} Preview epic sync from Jira
${ICON_SYNC} Preview story sync from Jira
${ICON_EXIT} Exit"
  else
    menu_options="${ICON_SYNC} Preview Jira
${ICON_EXIT} Exit"
  fi
elif $DEV_MODE; then
  menu_options="${ICON_NEW} Create issue
${ICON_TITLE} Work on existing issue
${ICON_TITLE} Export GitLab snapshot
${ICON_EXIT} Exit"
  if $JIRA_AVAILABLE; then
    menu_options="${ICON_SYNC} Sync epics from Jira
${ICON_SYNC} Sync stories from Jira
${menu_options}"
  fi
else
  if $JIRA_AVAILABLE; then
    menu_options="${ICON_SYNC} Sync Jira
${ICON_TITLE} Work on existing issue
${ICON_EXIT} Exit"
  else
    menu_options="${ICON_TITLE} Work on existing issue
${ICON_EXIT} Exit"
  fi
fi

action=$(fzf \
  --prompt="  What do you want to do? > " \
  --header="  ENTER=select" \
  --height=~40 \
  --reverse \
  --border=rounded \
  --border-label=" action " \
  --color="border:cyan,header:dim,prompt:cyan" \
  <<< "$menu_options" \
  || echo "")

if [[ -z "$action" ]]; then
  echo "  ${YELLOW}${ICON_WARN}${RESET} Aborted."
  exit 0

# ═══════════════════════════════════════════════════════════════
# PATH: EXIT
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Exit"* ]]; then
  echo "  ${DIM}Done.${RESET}"
  exit 0

# ═════════════════════════════════════════════════════════════
# PATH: RESET PROJECT PLANNING DATA
# ═════════════════════════════════════════════════════════════

elif [[ "$action" == *"full project reset"* || "$action" == *"Reset all issues"* ]]; then
  reset_project_planning_data
  exit $?

# PATH: WORK ON EXISTING ISSUE

elif [[ "$action" == *"Work on existing"* ]]; then
  work_on_existing_issue

# ═══════════════════════════════════════════════════════════════
# PATH: CREATE ISSUE
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Create"* ]]; then
  create_issue
  exit $?

# ═══════════════════════════════════════════════════════════════
# PATH: EXPORT GITLAB SNAPSHOT
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Export GitLab snapshot"* ]]; then
  export_gitlab_snapshot "manual"
  exit $?

# ═══════════════════════════════════════════════════════════════
# PATH: SYNC EPICS FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Sync epics"* ]]; then
  sync_epics
  exit $?

# ═══════════════════════════════════════════════════════════════
# PATH: SYNC STORIES FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Sync stories"* ]]; then
  sync_stories
  exit $?

# ═════════════════════════════════════════════════════════════
# PATH: SYNC JIRA
# ════════════════════════════════════════════════════════════

elif [[ "$action" == *"Sync Jira"* ]]; then
  # Story sync already reconciles Jira epics as GitLab milestones.
  sync_stories
  exit $?

# ═══════════════════════════════════════════════════════════════
# PATH: PREVIEW STORY SYNC FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Preview story sync"* ]]; then
  sync_stories dry-run
  exit $?

# ═══════════════════════════════════════════════════════════════
# PATH: PREVIEW EPIC SYNC FROM JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Preview epic sync"* ]]; then
  sync_epics dry-run
  exit $?

# ══════════════════════════════════════════════════════════════
# PATH: PREVIEW JIRA
# ═══════════════════════════════════════════════════════════════

elif [[ "$action" == *"Preview Jira"* ]]; then
  # Story preview includes the complete epic/milestone plan.
  sync_stories dry-run
  exit $?

fi
