{
  "version": 1,
  "youtrack": {
    "query": "project: ARC-CS-MIND tag: YOUR_VERSION_TAG Type: Epic, {User Story}",
    "fields": {
      "kind": "Type",
      "status": "State",
      "priority": "Priority"
    },
    "hierarchy": [
      {
        "role": "epic",
        "types": ["Epic"]
      },
      {
        "role": "story",
        "types": ["User Story"]
      }
    ]
  },
  "gitlab": {
    "targets": {
      "epic": "milestone",
      "story": "issue"
    }
  }
}
